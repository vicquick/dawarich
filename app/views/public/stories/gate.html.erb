<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title>Protected story</title>
  <style>
    @font-face {
      font-family: "Space Grotesk";
      font-style: normal; font-weight: 300 700; font-display: swap;
      src: url("/fonts/SpaceGrotesk.woff2") format("woff2-variations");
    }
    * { box-sizing: border-box; margin: 0; }
    body {
      font-family: "Space Grotesk", system-ui, sans-serif;
      background: #0b0e13; color: #e8eaed; min-height: 100vh;
      display: grid; place-items: center; padding: 2rem;
    }
    .gate { text-align: center; max-width: 22rem; width: 100%; }
    .gate .lock { font-size: 3rem; }
    .gate h1 { font-size: 1.3rem; margin: 1rem 0 .4rem; }
    .gate p { font-size: .85rem; opacity: .65; margin-bottom: 1.4rem; }
    .gate input[type="password"] {
      width: 100%; padding: .7rem .9rem; border-radius: .7rem; font: inherit;
      background: rgba(255,255,255,.08); color: inherit;
      border: 1px solid <%= @error ? '#ef4444' : 'rgba(255,255,255,.2)' %>;
      text-align: center; letter-spacing: .1em;
    }
    .gate button {
      margin-top: .8rem; width: 100%; padding: .7rem; border: 0; border-radius: .7rem;
      background: #f97316; color: #fff; font: 700 1rem "Space Grotesk", sans-serif; cursor: pointer;
    }
    .err { color: #ef4444; font-size: .8rem; margin-top: .6rem; }
  </style>
</head>
<body>
  <div class="gate">
    <div class="lock">🔐</div>
    <h1>This story is protected</h1>
    <p>Enter the password you were given to watch the journey.</p>
    <%= form_with url: story_unlock_path(@story.token), method: :post, local: true do %>
      <input type="password" name="password" autofocus autocomplete="current-password" placeholder="password">
      <button type="submit">Unlock</button>
    <% end %>
    <% if @error %><div class="err">Wrong password — try again.</div><% end %>
  </div>
</body>
</html>
