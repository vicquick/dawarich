<%# Place detail bottom sheet (vicquick fork) — Google-Maps-style %>
<%# Dimming backdrop — gives the sheet a clear "overlay" background; tap to close. %>
<div id="place-sheet-backdrop"
     style="position:fixed; inset:0; z-index:590; background:rgba(0,0,0,.32);
            opacity:0; pointer-events:none; transition:opacity .28s ease;"></div>
<div data-controller="place-sheet"
     data-place-sheet-api-key-value="<%= current_user.api_key %>"
     data-place-sheet-starred-tag-id-value="5"
     data-place-sheet-tags-value="<%= current_user.tags.order(:name).map { |t| { id: t.id, name: t.name, color: t.color, icon: t.icon } }.to_json %>"
     style="position:fixed; left:0; right:0; bottom:0; z-index:600; height:34vh;
            transform:translateY(100%); transition:transform .28s ease, height .28s ease;
            background:oklch(var(--b1)); color:oklch(var(--bc));
            border-top-left-radius:18px; border-top-right-radius:18px;
            box-shadow:0 -6px 24px rgba(0,0,0,.25); overflow:hidden; display:flex; flex-direction:column;"
     class="bg-base-100 text-base-content">

  <%# drag handle — drag up/down to resize, tap to toggle %>
  <div data-place-sheet-target="handle"
       style="cursor:grab; padding:10px 0 6px; display:flex; justify-content:center; flex:0 0 auto; touch-action:none;">
    <span style="width:44px; height:5px; border-radius:3px; background:rgba(128,128,128,.55); display:block;"></span>
  </div>

  <%# Title row + ✕ are PINNED between the grab bar and the scroll area — they
      used to live inside the scroller, so scrolling down to the tag chips
      carried the close button off-screen ("how to close place modal??"). %>
  <div style="padding:0 18px 6px; flex:0 0 auto; display:flex; align-items:flex-start; justify-content:space-between; gap:8px;">
    <div style="min-width:0;">
      <h3 data-place-sheet-target="title" style="margin:0; font-size:1.15rem; font-weight:700; line-height:1.2;">Place</h3>
      <p data-place-sheet-target="address" style="margin:2px 0 0; font-size:.85rem; opacity:.75;"></p>
      <p data-place-sheet-target="meta" data-action="click->place-sheet#copyCoords" title="Tap to copy coordinates" style="margin:2px 0 0; font-size:.72rem; opacity:.55; cursor:copy;"></p>
    </div>
    <button type="button" data-action="click->place-sheet#close" aria-label="Close"
            class="btn btn-ghost btn-sm btn-circle" style="flex:0 0 auto;">✕</button>
  </div>

  <div style="padding:0 18px 14px; overflow:auto; flex:1 1 auto; -webkit-overflow-scrolling:touch; overscroll-behavior:contain;">

    <%# INFO mode: actions + enrichment %>
    <div data-place-sheet-target="info">
      <%# ONE row: Directions · Save · Share — never wraps. Tight paddings via
          .ps-actions-row so all three (plus both carets) fit a 390px phone. %>
      <div class="ps-actions-row">
        <button type="button" data-action="click->place-sheet#directions" class="btn btn-primary btn-sm gap-1">
          <%= icon 'route' %> Directions
        </button>
        <%# Save is a split button like Share: the main half saves with the
            LAST-USED category one tap (remembered across places), the ▾ half
            toggles the category chips. Label is just "Save"/"Saved" + the
            category's icon — the icon carries the meaning. %>
        <span class="ps-share-split">
          <button type="button" data-place-sheet-target="categoryBtn"
                  data-action="click->place-sheet#quickSave"
                  class="btn btn-outline btn-sm gap-1">⭐ Save</button>
          <button type="button" data-action="click->place-sheet#toggleTagPicker"
                  data-place-sheet-target="categoryCaret"
                  class="btn btn-outline btn-sm px-2" aria-label="Choose category" title="Choose category">▾</button>
        </span>
        <%# Share + its ▾ are one unit: joined as a split button so the arrow can
            never wrap onto a line of its own. %>
        <span class="ps-share-split">
          <button type="button" data-action="click->place-sheet#share" class="btn btn-outline btn-sm gap-1">
            <span data-share-emoji>🔗</span> <span data-share-label>Share</span>
          </button>
          <button type="button" data-action="click->place-sheet#shareOptions" class="btn btn-outline btn-sm px-2"
                  aria-label="More share options">▾</button>
        </span>
      </div>
      <%# share chooser: coordinates / clean link / OSM (hidden until Share is tapped) %>
      <div data-share-options style="display:none; gap:8px; margin-top:10px; flex-wrap:wrap;">
        <button type="button" data-action="click->place-sheet#shareCoords" class="btn btn-ghost btn-xs">📍 Coordinates</button>
        <button type="button" data-action="click->place-sheet#shareLink" class="btn btn-ghost btn-xs">🔗 Map link</button>
        <button type="button" data-action="click->place-sheet#shareOsm" class="btn btn-ghost btn-xs">🌍 OSM link</button>
      </div>
      <div style="display:flex; gap:8px; margin-top:10px; flex-wrap:wrap;">
        <button type="button" data-action="click->place-sheet#streetView" class="btn btn-outline btn-sm gap-1" aria-label="Street View">🧍 Street View</button>
      </div>

      <%# Category picker (chips) — opens from the category button %>
      <%# Category chips — collapsed by default. display lives on the STYLE
          (not the `hidden` attribute): the old inline display:flex beat the
          UA's [hidden] rule, so the picker could never actually close. %>
      <div data-place-sheet-target="tagPicker"
           style="display:none; gap:6px; flex-wrap:wrap; margin-top:10px;"></div>

      <div data-place-sheet-target="enrichment" style="margin-top:14px;"></div>
    </div>

    <%# DIRECTIONS mode: the route panel lives inside the sheet (no separate
        floating popup). directions_manager fills these by id. %>
    <div id="directions-panel" data-place-sheet-target="directions" class="hidden" style="margin-top:12px;">
      <%# Trip planner — editable Start/End (Google-Maps style). Tap a field to change it. %>
      <div id="directions-trip" style="display:none;">
        <div class="trip-rows">
          <span class="trip-spine" aria-hidden="true"></span>
          <button type="button" data-action="click->place-sheet#editEndpoint" data-end="start" class="trip-field">
            <span class="trip-dot trip-dot--start"></span>
            <span data-place-sheet-target="startLabel" class="trip-text">Your location</span>
          </button>
          <%# Intermediate stops (multi-stop) rendered here by place_sheet_controller. %>
          <div data-place-sheet-target="waypoints" class="trip-waypoints"></div>
          <button type="button" data-action="click->place-sheet#editEndpoint" data-end="end" class="trip-field">
            <span class="trip-dot trip-dot--end"></span>
            <span data-place-sheet-target="endLabel" class="trip-text">Destination</span>
          </button>
          <button type="button" data-action="click->place-sheet#swapEnds" class="trip-swap" aria-label="Swap start and destination">⇅</button>
        </div>
        <button type="button" data-action="click->place-sheet#addStop" class="trip-add">＋ Add stop</button>
        <%# Fullscreen endpoint picker (Google-style) — map hidden behind, input on
            top, full scrollable results above the keyboard. %>
        <div data-place-sheet-target="endpointPicker" hidden class="ep-overlay">
          <div class="ep-bar">
            <button type="button" data-action="click->place-sheet#closeEndpointPicker" class="ep-back" aria-label="Back">‹</button>
            <input type="text" data-place-sheet-target="endpointInput"
                   data-action="input->place-sheet#endpointSearch keydown->place-sheet#endpointKeydown"
                   placeholder="Search a place or address" class="ep-input" autocomplete="off" aria-label="Search a place">
          </div>
          <ul data-place-sheet-target="endpointResults" class="ep-results"></ul>
        </div>
      </div>

      <%# PREVIEW header: back to place + travel-mode chips (hidden during active nav). %>
      <div id="directions-preview-header" style="display:flex; align-items:center; gap:8px;">
        <button type="button" data-action="click->place-sheet#backToInfo" class="btn btn-ghost btn-sm gap-1" style="flex:0 0 auto;">‹</button>
        <%# Modes, Google order: Walk (default) → Bike → Transit → Drive. Scrolls
            sideways on narrow screens so all stay reachable. %>
        <div style="display:flex; gap:4px; overflow:hidden; flex:1 1 auto;" role="group" aria-label="Travel mode">
          <button type="button" data-action="click->place-sheet#setMode" data-mode="pedestrian" class="btn btn-sm dir-mode btn-active" style="flex:0 0 auto;">🚶 Walk</button>
          <button type="button" data-action="click->place-sheet#setMode" data-mode="bicycle" class="btn btn-sm dir-mode" style="flex:0 0 auto;">🚲 Bike</button>
          <button type="button" data-action="click->place-sheet#setMode" data-mode="transit" class="btn btn-sm dir-mode" style="flex:0 0 auto;">🚆 Transit</button>
          <button type="button" data-action="click->place-sheet#setMode" data-mode="auto" class="btn btn-sm dir-mode" style="flex:0 0 auto;">🚗 Drive</button>
        </div>
      </div>
      <%# Live nav banner — the next manoeuvre (big arrow + distance + street). %>
      <div id="directions-nav-banner"
           style="display:none; align-items:center; gap:12px; margin-top:12px; padding:10px 13px;
                  border-radius:14px; background:#1a73e8; color:#fff;">
        <span id="directions-nav-arrow" style="font-size:1.7rem; line-height:1; flex:0 0 auto;">↑</span>
        <div style="min-width:0;">
          <div id="directions-nav-dist" style="font-size:1.15rem; font-weight:800; line-height:1.1;"></div>
          <div id="directions-nav-instr" style="font-size:.85rem; opacity:.95; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;"></div>
        </div>
        <button type="button" id="directions-recenter" data-action="click->place-sheet#recenter" hidden
                style="margin-left:auto; flex:0 0 auto; background:rgba(255,255,255,.22); border:0; color:#fff;
                       border-radius:999px; padding:6px 12px; font-size:.8rem; font-weight:700; cursor:pointer;">◎ Re-center</button>
      </div>
      <p id="directions-status" style="margin:10px 0 0; font-size:.8rem; opacity:.7;">Locating you…</p>
      <p id="directions-summary" style="margin:6px 0 0; font-size:1.05rem; font-weight:700; color:#2563eb;"></p>

      <%# Route alternatives — tap to pick (only shown when >1 route). %>
      <div id="directions-routes" style="display:none; gap:8px; flex-wrap:wrap; margin-top:12px;"></div>

      <%# PREVIEW actions: Start nav + ride-hailing hand-off (opens Uber/Bolt). %>
      <div id="directions-preview-actions" style="display:flex; align-items:center; gap:8px; flex-wrap:wrap; margin-top:12px;">
        <button type="button" data-action="click->place-sheet#startNav" class="btn btn-primary btn-sm gap-1" style="font-weight:700;">▶ Start</button>
        <button type="button" data-action="click->place-sheet#shareRoute" class="btn btn-outline btn-sm gap-1" aria-label="Share route">↗ Share</button>
        <button type="button" data-action="click->place-sheet#exportGpx" class="btn btn-outline btn-sm gap-1" aria-label="Download route as GPX">⭳ GPX</button>
        <a id="ride-uber" href="#" target="_blank" rel="noopener" class="btn btn-outline btn-sm gap-1">🚕 Uber</a>
        <a id="ride-bolt" href="#" target="_blank" rel="noopener" class="btn btn-outline btn-sm gap-1">⚡ Bolt</a>
      </div>

      <%# NAV controls: 2D/3D toggle + End nav (back to preview). Shown only while navigating. %>
      <div id="directions-nav-controls" style="display:none; align-items:center; gap:8px; margin-top:12px;">
        <button type="button" id="directions-2d-toggle" data-action="click->place-sheet#toggle2D" class="btn btn-outline btn-sm gap-1">⊞ 2D</button>
        <button type="button" data-action="click->place-sheet#endNav" class="btn btn-error btn-sm gap-1" style="margin-left:auto;">✕ End</button>
      </div>

      <ol id="directions-turns" style="margin:10px 0 0; padding:0; list-style:none;"></ol>
    </div>
  </div>
</div>

<style>
  /* --- Trip planner (editable start/end) --- */
  #directions-trip { display:none; margin-bottom:12px; }
  .trip-rows { position:relative; display:flex; flex-direction:column; gap:8px; }
  .trip-spine { position:absolute; left:9px; top:18px; bottom:30px; width:2px;
    background:repeating-linear-gradient(rgba(128,128,128,.45) 0 3px, transparent 3px 6px); }
  .trip-field { display:flex; align-items:center; gap:11px; width:100%; text-align:left;
    border:0; background:color-mix(in oklch, oklch(var(--bc)) 7%, transparent); color:inherit;
    border-radius:12px; padding:11px 12px; font:inherit; font-size:.95rem; cursor:pointer; }
  .trip-field:hover { background:color-mix(in oklch, oklch(var(--bc)) 12%, transparent); }
  .trip-dot { flex:0 0 auto; width:11px; height:11px; border-radius:50%; z-index:1;
    box-shadow:0 0 0 3px oklch(var(--b1)); }
  .trip-dot--start { background:#1a73e8; }
  .trip-dot--end { background:#ea4335; border-radius:3px; }
  .trip-dot--wp { background:#f59e0b; }

  /* Multi-stop rows */
  .trip-waypoints { display:flex; flex-direction:column; }
  .trip-wp { display:flex; align-items:center; gap:11px; padding:9px 0; position:relative; }
  .trip-wp .trip-text { flex:1 1 auto; min-width:0; border:0; background:transparent; color:inherit;
    text-align:left; font:inherit; cursor:pointer; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; padding:0; }
  .trip-drag { flex:0 0 auto; width:20px; text-align:center; cursor:grab; opacity:.4; font-size:1rem;
    touch-action:none; -webkit-user-select:none; user-select:none; }
  .trip-drag:active { cursor:grabbing; opacity:.8; }
  .trip-wp--dragging { cursor:grabbing; }
  .trip-wp--dragging .trip-text, .trip-wp--dragging .trip-dot {
    background:oklch(var(--b1)); box-shadow:0 8px 22px rgba(0,0,0,.28); }
  .trip-wp--dragging { border-radius:12px; background:oklch(var(--b1)); box-shadow:0 8px 22px rgba(0,0,0,.28); }
  .trip-wp-del { flex:0 0 auto; width:26px; height:26px; border:0; border-radius:50%; background:transparent;
    color:inherit; opacity:.45; cursor:pointer; font-size:.8rem; }
  .trip-wp-del:hover { opacity:.9; background:color-mix(in oklch, oklch(var(--bc)) 14%, transparent); }
  .trip-add { display:inline-flex; align-items:center; gap:6px; margin-top:8px; padding:7px 12px;
    border:1px dashed color-mix(in oklch, oklch(var(--bc)) 28%, transparent); border-radius:999px;
    background:transparent; color:inherit; font:inherit; font-size:.85rem; font-weight:600; cursor:pointer; opacity:.85; }
  .trip-add:hover { opacity:1; background:color-mix(in oklch, oklch(var(--bc)) 8%, transparent); }
  .trip-text { flex:1 1 auto; min-width:0; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .trip-swap { position:absolute; right:6px; top:50%; transform:translateY(-50%);
    width:34px; height:34px; border:0; border-radius:50%; cursor:pointer; font-size:1rem;
    background:oklch(var(--b1)); color:inherit; box-shadow:0 1px 5px rgba(0,0,0,.18); }
  .trip-picker { margin-top:8px; }
  .trip-input { width:100%; border:1px solid color-mix(in oklch, oklch(var(--bc)) 18%, transparent);
    background:oklch(var(--b1)); color:inherit; border-radius:11px; padding:10px 12px; font:inherit; outline:none; }
  .trip-input:focus { border-color:color-mix(in oklch, oklch(var(--bc)) 34%, transparent);
    box-shadow:none !important; --tw-ring-shadow:0 0 #0000 !important; }
  .trip-results { list-style:none; margin:6px 0 0; padding:0; max-height:34vh; overflow:auto; }
  .trip-results li button { display:flex; align-items:center; gap:10px; width:100%; text-align:left;
    border:0; background:transparent; color:inherit; border-radius:9px; padding:9px 8px; cursor:pointer; font:inherit; }
  .trip-results li button:hover { background:color-mix(in oklch, oklch(var(--bc)) 10%, transparent); }
  .trip-res-dot { flex:0 0 auto; width:26px; height:26px; border-radius:50%;
    display:flex; align-items:center; justify-content:center; font-size:.9rem;
    background:color-mix(in oklch, oklch(var(--bc)) 12%, transparent); }
  .trip-res-sub { font-size:.76rem; opacity:.6; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }

  /* --- Fullscreen endpoint picker (Google-style stop search) --- */
  .ep-overlay {
    position: fixed; inset: 0; z-index: 700;
    background: oklch(var(--b1)); color: oklch(var(--bc));
    display: flex; flex-direction: column;
    padding-top: env(safe-area-inset-top);
  }
  .ep-overlay[hidden] { display: none; }
  .ep-bar {
    display: flex; align-items: center; gap: 8px;
    padding: 10px 12px; flex: 0 0 auto;
    border-bottom: 1px solid color-mix(in oklch, oklch(var(--bc)) 12%, transparent);
  }
  .ep-back {
    flex: 0 0 auto; width: 40px; height: 40px; border: 0; border-radius: 50%;
    background: transparent; color: inherit; font-size: 1.6rem; line-height: 1; cursor: pointer;
  }
  .ep-back:hover { background: color-mix(in oklch, oklch(var(--bc)) 12%, transparent); }
  .ep-input {
    flex: 1 1 auto; min-width: 0;
    border: 1px solid color-mix(in oklch, oklch(var(--bc)) 18%, transparent);
    background: oklch(var(--b1)); color: inherit;
    border-radius: 12px; padding: 11px 14px; font: inherit; font-size: 1rem; outline: none;
  }
  .ep-input:focus {
    border-color: color-mix(in oklch, oklch(var(--bc)) 34%, transparent);
    box-shadow: none !important; --tw-ring-shadow: 0 0 #0000 !important;
  }
  .ep-results { list-style: none; margin: 0; padding: 6px; overflow-y: auto; flex: 1 1 auto; -webkit-overflow-scrolling: touch; }
  .ep-results li button {
    display: flex; align-items: flex-start; gap: 12px; width: 100%; text-align: left;
    border: 0; background: transparent; color: inherit; border-radius: 12px;
    padding: 12px 10px; cursor: pointer; font: inherit;
  }
  .ep-results li button:hover, .ep-results li button:active { background: color-mix(in oklch, oklch(var(--bc)) 8%, transparent); }
  .ep-res-dot {
    flex: 0 0 auto; width: 30px; height: 30px; border-radius: 50%; margin-top: 1px;
    display: flex; align-items: center; justify-content: center;
    background: color-mix(in oklch, oklch(var(--bc)) 12%, transparent); font-size: 1rem;
  }
  .ep-res-txt { min-width: 0; flex: 1 1 auto; }
  .ep-res-name { display: block; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  /* Address wraps to ≤2 lines instead of a sideways-clipped single line. */
  .ep-res-sub {
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
    overflow: hidden; font-size: .82rem; opacity: .6; margin-top: 1px;
  }

  /* --- Directions: clearer Google-like travel-mode selector --- */
  .dir-mode {
    border-radius: 999px !important;
    border: 1px solid color-mix(in oklch, oklch(var(--bc)) 18%, transparent) !important;
    background: transparent !important; color: inherit !important;
    font-weight: 600; opacity: 0.82;
    transition: background .15s ease, color .15s ease, opacity .15s ease, border-color .15s ease;
    /* Crunch: all four fit one row on mobile without sideways scroll. */
    flex: 1 1 0; min-width: 0; height: auto; min-height: 0;
    padding: 0.32rem 0.35rem !important; font-size: 0.78rem !important;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    gap: 0.2rem !important;
  }
  .dir-mode:hover { opacity: 1; background: color-mix(in oklch, oklch(var(--bc)) 8%, transparent) !important; }
  .dir-mode.btn-active {
    background: #1a73e8 !important; border-color: #1a73e8 !important; color: #fff !important; opacity: 1;
  }
  /* Share + ▾ as a joined split button — they stay together on wrap and read as
     one control rather than two adjacent pills. */
  /* Primary action row — Directions · Save · Share on ONE line, always. */
  .ps-actions-row {
    display: flex; gap: 6px; margin-top: 14px;
    flex-wrap: nowrap; align-items: stretch; min-width: 0;
  }
  .ps-actions-row .btn {
    padding-left: 0.6rem; padding-right: 0.6rem;
    font-size: 0.8rem; white-space: nowrap;
  }
  .ps-actions-row .ps-share-split .btn:last-child {
    padding-left: 0.45rem; padding-right: 0.45rem; min-width: 1.6rem;
  }

  .ps-share-split { display: inline-flex; flex: 0 0 auto; }
  .ps-share-split > .btn:first-child {
    border-top-right-radius: 0 !important; border-bottom-right-radius: 0 !important;
  }
  .ps-share-split > .btn:last-child {
    border-top-left-radius: 0 !important; border-bottom-left-radius: 0 !important;
    border-left-width: 0 !important; min-width: 2rem;
  }

  /* Loading skeleton for the place photo strip + info line. Mirrors the real
     layout (112px tiles) so the sheet doesn't jump when photos land. */
  .ps-skeleton__strip { display: flex; gap: 7px; overflow: hidden; margin-bottom: 11px; }
  .ps-skeleton__strip .ps-shimmer { flex: 0 0 auto; width: 150px; height: 112px; border-radius: 11px; }
  .ps-shimmer {
    display: block; border-radius: 11px;
    background: linear-gradient(
      100deg,
      color-mix(in oklch, oklch(var(--bc)) 7%, transparent) 30%,
      color-mix(in oklch, oklch(var(--bc)) 14%, transparent) 50%,
      color-mix(in oklch, oklch(var(--bc)) 7%, transparent) 70%);
    background-size: 220% 100%;
    animation: ps-shimmer 1.25s ease-in-out infinite;
  }
  .ps-shimmer--line { height: .8rem; width: 62%; border-radius: 999px; }
  @keyframes ps-shimmer { from { background-position: 180% 0; } to { background-position: -40% 0; } }
  @media (prefers-reduced-motion: reduce) {
    .ps-shimmer { animation: none; }
  }

  /* Prominent ETA summary + pill Start CTA */
  #directions-summary { font-size: 1.25rem !important; }
  #directions-preview-actions .btn-primary {
    height: 2.5rem; padding-inline: 1.3rem; border-radius: 999px; font-size: .95rem;
  }

  /* --- Routing mode: hide history-browsing chrome, slim the top --- */
  body.routing-active .map-date-float,
  body.routing-active [data-controller~="map-controls"],
  body.routing-active #map-button-cluster,
  body.routing-active .map-button-cluster { display:none !important; }
</style>
