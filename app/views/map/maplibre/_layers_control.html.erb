<%# Google-Maps-style Layers control (vicquick fork). Replaces the standalone
    incident toggle: pick a base map + toggle overlays, active ones highlighted.
    Thumbnails are live tiles of the home region. %>
<div data-controller="layers-control" class="layers-control">
  <%# The panel (opens above the button) %>
  <div data-layers-control-target="panel" class="layers-panel">
    <div class="layers-panel__section-title">Map type</div>
    <div class="layers-chips">
      <% chips = [
        ["white",   "Light",     "https://a.basemaps.cartocdn.com/light_all/11/1083/665.png"],
        ["dark",    "Dark",      "https://a.basemaps.cartocdn.com/dark_all/11/1083/665.png"],
        ["aerial",  "Satellite", "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/11/665/1083"]
      ]
      # vicquick fork: the "Outdoor" (Mapy.com) chip appears only once a free
      # MAPY_API_KEY is configured — until then we don't show a topo option
      # (OpenTopoMap was dropped).
      if ENV['MAPY_API_KEY'].present?
        # Keep drawn map styles together, imagery last.
        chips.insert(2, ["mapy", "Outdoor", "https://api.mapy.com/v1/maptiles/outdoor/256/11/1083/665?apikey=#{ENV['MAPY_API_KEY']}"])
      end
      chips.each do |val, label, thumb| %>
        <button type="button" class="layers-chip" data-basemap="<%= val %>"
                data-layers-control-target="chip"
                data-action="click->layers-control#pickBase"
                aria-label="<%= label %> map">
          <span class="layers-chip__thumb" style="background-image:url('<%= thumb %>')">
            <span class="layers-chip__check" aria-hidden="true">✓</span>
          </span>
          <span class="layers-chip__label"><%= label %></span>
        </button>
      <% end %>
    </div>

    <div class="layers-panel__divider"></div>

    <div class="layers-panel__section-title">Overlays</div>
    <button type="button" class="layers-overlay"
            data-layers-control-target="trafficToggle"
            data-action="click->layers-control#toggleTraffic"
            aria-pressed="false" aria-label="Toggle live road incidents">
      <span class="layers-overlay__icon">⚠</span>
      <span class="layers-overlay__label">Traffic incidents</span>
      <span class="layers-overlay__switch" aria-hidden="true"></span>
    </button>
    <button type="button" class="layers-overlay"
            data-layers-control-target="streetToggle"
            data-action="click->layers-control#toggleStreet"
            aria-pressed="false" aria-label="Toggle Street View">
      <span class="layers-overlay__icon">🧍</span>
      <span class="layers-overlay__label">Street View</span>
      <span class="layers-overlay__switch" aria-hidden="true"></span>
    </button>
    <button type="button" class="layers-overlay layers-overlay--photos"
            data-layers-control-target="immichToggle"
            data-action="click->layers-control#toggleImmich"
            aria-pressed="false" aria-label="Toggle your photos on the map">
      <span class="layers-overlay__icon">📷</span>
      <span class="layers-overlay__label">Photos</span>
      <span class="layers-overlay__switch" aria-hidden="true"></span>
    </button>
    <button type="button" class="layers-overlay layers-overlay--weather"
            data-layers-control-target="weatherToggle"
            data-action="click->layers-control#toggleWeather"
            aria-pressed="false" aria-label="Toggle live rain radar">
      <span class="layers-overlay__icon">🌧</span>
      <span class="layers-overlay__label">Weather</span>
      <span class="layers-overlay__switch" aria-hidden="true"></span>
    </button>
    <button type="button" class="layers-overlay layers-overlay--trails"
            data-layers-control-target="trailsToggle"
            data-action="click->layers-control#toggleTrails"
            aria-pressed="false" aria-label="Toggle hiking trails">
      <span class="layers-overlay__icon">🥾</span>
      <span class="layers-overlay__label">Trails</span>
      <span class="layers-overlay__switch" aria-hidden="true"></span>
    </button>

    <div class="layers-panel__divider"></div>
    <%# Your own data layers, moved here from the old native "Layers" tab so
        there's one menu instead of two. %>
    <%= render 'map/maplibre/layer_toggles' %>

    <%# The long tail of numeric config (fog radius, detection thresholds,
        route splitting…) stays in the settings panel — rare, deliberate. %>
    <button type="button" class="layers-more"
            data-action="click->maps--maplibre#toggleSettings">More settings →</button>
  </div>

  <%# The trigger button (bottom-right) %>
  <button type="button" data-layers-control-target="button"
          data-action="click->layers-control#toggleOpen"
          class="layers-button" aria-expanded="false" aria-label="Map layers" title="Layers">
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor"
         stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
      <polyline points="2 17 12 22 22 17"></polyline>
      <polyline points="2 12 12 17 22 12"></polyline>
    </svg>
  </button>
</div>

<style>
  /* Info glyph (ringed "i") used as a mask so it takes the theme colour. */
  :root {
    --dw-info: url("data:image/svg+xml;utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Cpath d='M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm-1-13h2v2h-2zm0 4h2v6h-2z'/%3E%3C/svg%3E");
  }
  .layers-control { position: absolute; right: 0.75rem; bottom: 7.5rem; z-index: 556; }
  /* Trigger button — rounded square, like Google's layer chip. */
  .layers-button {
    width: 2.8rem; height: 2.8rem; border-radius: 0.85rem;
    background: oklch(var(--b1)); color: oklch(var(--bc));
    border: 1px solid color-mix(in oklch, oklch(var(--bc)) 12%, transparent);
    box-shadow: 0 2px 12px rgba(0,0,0,.26);
    display: flex; align-items: center; justify-content: center; cursor: pointer;
    transition: transform .12s ease, background .18s ease;
  }
  .layers-button:hover { background: color-mix(in oklch, oklch(var(--b1)) 92%, oklch(var(--bc))); }
  .layers-button:active { transform: scale(.95); }

  /* Panel — opens above the button, anchored bottom-right. */
  .layers-panel {
    position: absolute; right: 0; bottom: 3.6rem;
    width: min(92vw, 22rem); padding: 0.85rem 0.95rem 0.95rem;
    background: oklch(var(--b1)); color: oklch(var(--bc));
    border: 1px solid color-mix(in oklch, oklch(var(--bc)) 10%, transparent);
    border-radius: 1.1rem; box-shadow: 0 10px 34px rgba(0,0,0,.30);
    transform-origin: bottom right; transform: translateY(8px) scale(.96);
    opacity: 0; pointer-events: none;
    transition: opacity .16s ease, transform .16s cubic-bezier(.2,.7,.2,1);
  }
  .layers-panel--open { opacity: 1; transform: translateY(0) scale(1); pointer-events: auto; }
  /* Holds the full layer list now, so it scrolls inside the viewport instead
     of running off the top of the screen. */
  .layers-panel {
    max-height: min(72vh, 40rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
  }
  /* DaisyUI form rows inherited from the old panel — tighten them to the
     card's rhythm so moved toggles don't look pasted in. */
  .layers-panel .form-control .label { padding: 0.2rem 0; }
  .layers-panel .form-control .label-text { font-size: 0.9rem; }
  .layers-panel .form-control p { font-size: 0.72rem; line-height: 1.25; }
  .layers-panel .space-y-4 > * + * { margin-top: 0.55rem; }
  .layers-panel .divider { margin: 0.4rem 0; }
  .layers-advanced__summary { cursor: pointer; list-style: none; user-select: none; }
  .layers-advanced__summary::-webkit-details-marker { display: none; }
  .layers-advanced__summary::after { content: " ▾"; opacity: .6; }
  .layers-advanced[open] .layers-advanced__summary::after { content: " ▴"; }
  .layers-advanced__body { margin-top: .5rem; }
  .layers-more {
    display: block; width: 100%; margin-top: .7rem; padding: .45rem 0;
    background: none; border: none; cursor: pointer; text-align: left;
    font-size: .8rem; font-weight: 600; opacity: .7; color: inherit;
  }
  .layers-more:hover { opacity: 1; }

  .layers-panel__section-title {
    font-size: .72rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase;
    opacity: .55; margin: 0 0 .5rem 2px;
  }
  .layers-panel__divider {
    height: 1px; margin: .8rem 0 .75rem;
    background: color-mix(in oklch, oklch(var(--bc)) 10%, transparent);
  }

  /* The scroll container clips overflow, and the active chip paints OUTSIDE
     its box — a blue ring, a drop glow, and a ✓ badge hanging off the corner.
     Pad on every side so none of that gets cut, then pull the padding back
     with a matching negative margin so the visual spacing is unchanged. */
  .layers-chips {
    display: flex; gap: .55rem; overflow-x: auto; scrollbar-width: none;
    padding: .45rem .45rem .6rem; margin: -.45rem -.45rem -.45rem;
  }
  .layers-chips::-webkit-scrollbar { display: none; }
  .layers-chip {
    flex: 0 0 auto; width: 4.1rem; background: none; border: none; padding: 0;
    cursor: pointer; display: flex; flex-direction: column; align-items: center; gap: .3rem;
  }
  .layers-chip__thumb {
    position: relative; width: 4.1rem; height: 4.1rem; border-radius: .7rem;
    background-size: cover; background-position: center; background-color: oklch(var(--b2));
    box-shadow: inset 0 0 0 2px transparent, 0 1px 4px rgba(0,0,0,.18);
    transition: box-shadow .14s ease, transform .12s ease;
  }
  .layers-chip:hover .layers-chip__thumb { transform: translateY(-1px); }
  .layers-chip__check {
    position: absolute; top: -.35rem; right: -.35rem; width: 1.15rem; height: 1.15rem;
    border-radius: 50%; background: #1a73e8; color: #fff; font-size: .72rem; font-weight: 800;
    display: none; align-items: center; justify-content: center; box-shadow: 0 1px 4px rgba(0,0,0,.3);
  }
  .layers-chip__label { font-size: .72rem; font-weight: 600; opacity: .8; }
  .layers-chip--active .layers-chip__thumb { box-shadow: inset 0 0 0 2.5px #1a73e8, 0 2px 8px rgba(26,115,232,.35); }
  .layers-chip--active .layers-chip__check { display: flex; }
  .layers-chip--active .layers-chip__label { opacity: 1; color: #1a73e8; }

  .layers-overlay {
    width: 100%; display: flex; align-items: center; gap: .6rem; cursor: pointer;
    background: none; border: none; padding: .4rem .2rem; color: inherit; text-align: left;
  }
  .layers-overlay__icon { font-size: 1.05rem; width: 1.6rem; text-align: center; }
  .layers-overlay__label { flex: 1 1 auto; font-size: .9rem; font-weight: 500; }
  .layers-overlay__switch {
    flex: 0 0 auto; width: 2.4rem; height: 1.4rem; border-radius: 999px; position: relative;
    background: color-mix(in oklch, oklch(var(--bc)) 22%, transparent); transition: background .18s ease;
  }
  .layers-overlay__switch::after {
    content: ""; position: absolute; top: 2px; left: 2px; width: 1rem; height: 1rem;
    border-radius: 50%; background: #fff; box-shadow: 0 1px 3px rgba(0,0,0,.3); transition: transform .18s ease;
  }
  .layers-overlay--on .layers-overlay__switch { background: #ea4335; }
  .layers-overlay--on .layers-overlay__switch::after { transform: translateX(1rem); }
  /* Photos overlay reads teal when on, matching its map cluster colour. */
  .layers-overlay--photos.layers-overlay--on .layers-overlay__switch { background: #0d9488; }
  /* Weather overlay reads sky-blue when on, matching the rain radar. */
  .layers-overlay--weather.layers-overlay--on .layers-overlay__switch { background: #0284c7; }
  /* Trails overlay reads trail-red when on. */
  .layers-overlay--trails.layers-overlay--on .layers-overlay__switch { background: #dc2626; }

  /* Immich photo popup — clean framed preview, theme-aware. */
  .immich-popup .maplibregl-popup-content {
    padding: .45rem; border-radius: .8rem;
    background: oklch(var(--b1)); color: oklch(var(--bc));
    box-shadow: 0 10px 30px rgba(0,0,0,.34);
  }
  .immich-popup .maplibregl-popup-tip { border-top-color: oklch(var(--b1)); }
  .immich-pop { width: 240px; max-width: 62vw; }
  .immich-pop__link { display: block; cursor: zoom-in; }
  .immich-pop__link:hover .immich-pop__img { opacity: .93; }
  .immich-pop__img { display: block; width: 100%; height: auto; border-radius: .55rem; transition: opacity .15s ease; }
  .immich-pop__meta { margin: .45rem .15rem .1rem; font-size: .8rem; font-weight: 600; opacity: .72; }

  /* Theme the native MapLibre controls (zoom / compass / geolocate) to match
     the app chrome: rounded dark cards, bigger tap targets, theme-aware icons. */
  .maplibregl-ctrl-group {
    background: oklch(var(--b1)) !important;
    border: 1px solid color-mix(in oklch, oklch(var(--bc)) 12%, transparent) !important;
    border-radius: 0.85rem !important;
    box-shadow: 0 2px 12px rgba(0,0,0,.26) !important;
    overflow: hidden;
  }
  .maplibregl-ctrl-group button {
    width: 2.4rem; height: 2.4rem; background: transparent !important;
  }
  .maplibregl-ctrl-group button + button {
    border-top: 1px solid color-mix(in oklch, oklch(var(--bc)) 10%, transparent) !important;
  }
  .maplibregl-ctrl-group button:hover {
    background: color-mix(in oklch, oklch(var(--b1)) 90%, oklch(var(--bc))) !important;
  }
  /* Default control icons are dark SVGs — invert on dark backgrounds so they
     stay legible on the dark card. */
  :root[data-theme="dark"] .maplibregl-ctrl-group .maplibregl-ctrl-icon,
  .dark .maplibregl-ctrl-group .maplibregl-ctrl-icon {
    filter: invert(1) brightness(1.7);
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .maplibregl-ctrl-group .maplibregl-ctrl-icon { filter: invert(1) brightness(1.7); }
  }

  /* Attribution credits — COLLAPSED it's a clean circular (i) chip that matches
     the other map controls; EXPANDED it becomes a rounded pill of text. MapLibre's
     compact mode nests a round button inside the bar, so both must share the
     same radius/size or you get a pill-inside-a-circle silhouette. */
  .maplibregl-ctrl-bottom-right .maplibregl-ctrl-attrib.maplibregl-compact {
    position: relative;
    box-sizing: border-box;
    min-height: 2rem; min-width: 2rem;
    width: 2rem; height: 2rem; margin: 0 10px 10px 0; padding: 0;
    border-radius: 999px !important;
    background: oklch(var(--b1)) !important;
    border: 1px solid color-mix(in oklch, oklch(var(--bc)) 12%, transparent);
    box-shadow: 0 2px 12px rgba(0,0,0,.26);
    display: grid; place-items: center;
    overflow: hidden;
    transition: none;
  }
  /* Expanded pill is content-sized, not a fixed circle. */
  .maplibregl-ctrl-bottom-right .maplibregl-ctrl-attrib.maplibregl-compact.maplibregl-compact-show {
    width: auto; height: auto;
    border-radius: 1rem !important;
    display: flex; align-items: center;
  }
  /* Collapsed: hide the text entirely so only the (i) circle shows. */
  .maplibregl-ctrl-attrib.maplibregl-compact .maplibregl-ctrl-attrib-inner {
    display: none;
    padding: 0 0.7rem 0 0.55rem;
    font-size: .66rem; line-height: 2rem; white-space: nowrap;
  }
  /* Expanded (MapLibre sets -show): pill grows to fit the credits text. */
  .maplibregl-ctrl-attrib.maplibregl-compact-show { height: auto; min-height: 2rem; }
  .maplibregl-ctrl-attrib.maplibregl-compact-show .maplibregl-ctrl-attrib-inner {
    display: block; max-width: min(74vw, 30rem);
    white-space: normal; line-height: 1.35; padding: .45rem .75rem .45rem .5rem;
  }
  /* The (i) toggle. MapLibre ships a WHITE DISC image and absolutely-positions
     the button, which left an off-centre white blob inside our dark chip. Drop
     the image entirely and draw the glyph with a mask so it's a clean "i" in
     the theme's foreground colour, perfectly centred in the chip. */
  .maplibregl-ctrl-attrib .maplibregl-ctrl-attrib-button {
    order: -1; flex: 0 0 auto;
    box-sizing: border-box;
    margin: 0 !important; padding: 0;
    border-radius: 999px;
    background-color: transparent !important;
    background-image: none !important;
    box-shadow: none !important; border: none !important;
    filter: none !important;
    display: block;
  }
  /* COLLAPSED: pin the button to the chip's padding box with inset:0. A
     percentage height can't resolve here (the grid row is content-sized, which
     collapsed the button to 30x15), and a fixed 2rem overflowed the 30px
     content box — both pushed the glyph off-centre. inset:0 is exact. */
  .maplibregl-ctrl-attrib.maplibregl-compact:not(.maplibregl-compact-show) .maplibregl-ctrl-attrib-button {
    position: absolute !important;
    inset: 0 !important;
    width: auto !important; height: auto !important;
  }
  .maplibregl-ctrl-attrib .maplibregl-ctrl-attrib-button::before {
    content: "";
    position: absolute; inset: 0;
    background-color: oklch(var(--bc));
    opacity: .8;
    -webkit-mask: var(--dw-info) center / 1.05rem 1.05rem no-repeat;
    mask: var(--dw-info) center / 1.05rem 1.05rem no-repeat;
  }
  .maplibregl-ctrl-attrib .maplibregl-ctrl-attrib-button:hover::before { opacity: 1; }
  /* EXPANDED: back in flow as a fixed square so the credits text flows beside it. */
  .maplibregl-ctrl-attrib.maplibregl-compact-show .maplibregl-ctrl-attrib-button {
    position: relative !important; inset: auto !important;
    width: 1.9rem !important; height: 1.9rem !important;
  }
  .maplibregl-ctrl-attrib, .maplibregl-ctrl-attrib a { color: oklch(var(--bc)) !important; }
  .maplibregl-ctrl-attrib a { opacity: .7; text-decoration: none; }
  .maplibregl-ctrl-attrib a:hover { opacity: 1; text-decoration: underline; }

  /* Hide the old standalone incident toggle — folded into this control now. */
  .traffic-toggle { display: none !important; }

  /* While routing, the map is the hero — tuck the layers control away too. */
  body.routing-active .layers-control { display: none; }

  /* Mobile: the trigger lives in the LEFT button cluster now (Victor prefers
     the cluster's card styling + the left edge), so the floating corner
     button hides and the panel opens from the top-LEFT beside the cluster. */
  @media (max-width: 768px) {
    .layers-control {
      top: max(4.75rem, calc(env(safe-area-inset-top) + 4rem));
      bottom: auto; left: 0.75rem; right: auto;
    }
    .layers-control .layers-button { display: none; }
    .layers-panel {
      top: 0; bottom: auto; left: 3.4rem; right: auto;
      width: min(calc(100vw - 4.6rem), 22rem);
      transform-origin: top left; transform: translateY(-8px) scale(.96);
      /* Same card recipe as the button cluster — translucent base + blur. */
      background: oklch(var(--b1) / 0.95);
      backdrop-filter: blur(6px);
      border: 1px solid oklch(var(--bc) / 0.15);
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
    }
    .layers-panel--open { transform: translateY(0) scale(1); }
  }
</style>
