{
  "version": 8,
  "name": "Aerial (Satellite)",
  "glyphs": "https://protomaps.github.io/basemaps-assets/fonts/{fontstack}/{range}.pbf",
  "sprite": "https://protomaps.github.io/basemaps-assets/sprites/v4/light",
  "sources": {
    "esri-imagery": {
      "type": "raster",
      "tiles": ["https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}"],
      "tileSize": 256,
      "maxzoom": 19,
      "attribution": "Imagery © <a href=\"https://www.esri.com\">Esri</a>, Maxar, Earthstar Geographics"
    },
    "carto-labels": {
      "type": "raster",
      "tiles": [
        "https://a.basemaps.cartocdn.com/rastertiles/voyager_only_labels/{z}/{x}/{y}.png",
        "https://b.basemaps.cartocdn.com/rastertiles/voyager_only_labels/{z}/{x}/{y}.png",
        "https://c.basemaps.cartocdn.com/rastertiles/voyager_only_labels/{z}/{x}/{y}.png"
      ],
      "tileSize": 256,
      "maxzoom": 20,
      "attribution": "Labels © <a href=\"https://carto.com/attributions\">CARTO</a>"
    },
    "lgln-dop20": {
      "type": "raster",
      "tiles": [
        "https://opendata.lgln.niedersachsen.de/doorman/noauth/dop_wms?SERVICE=WMS&VERSION=1.3.0&REQUEST=GetMap&LAYERS=ni_dop20&STYLES=&CRS=EPSG:3857&WIDTH=512&HEIGHT=512&FORMAT=image/png&TRANSPARENT=TRUE&BBOX={bbox-epsg-3857}"
      ],
      "tileSize": 512,
      "minzoom": 11,
      "maxzoom": 20,
      "attribution": "DOP20 © <a href=\"https://www.lgln.niedersachsen.de\">LGLN</a> (dl-de/by-2-0)"
    }
  },
  "layers": [
    { "id": "background", "type": "background", "paint": { "background-color": "#1c1c1c" } },
    { "id": "esri-imagery", "type": "raster", "source": "esri-imagery" },
    { "id": "lgln-dop20", "type": "raster", "source": "lgln-dop20", "minzoom": 11 },
    { "id": "carto-labels", "type": "raster", "source": "carto-labels", "paint": { "raster-opacity": 0.92 } }
  ]
}
